# ---- API ----
ENV=development
DATABASE_URL=postgresql+psycopg://stockcast:stockcast@postgres:5432/stockcast
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
# Any string; used to derive the Fernet key that encrypts channel credentials. Rotate = re-connect channels.
CREDENTIALS_KEY=change-me-in-production
# Used by pytest (apps/api/tests/conftest.py); tests migrate + roll back on this DB
TEST_DATABASE_URL=postgresql+psycopg://stockcast:stockcast@localhost:5432/stockcast_test

# ---- Ingestion ----
# Public URL Shopify can reach for OAuth callback + webhooks (use an ngrok/cloudflared URL locally)
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Shopify Partner app credentials: https://partners.shopify.com -> Apps -> Create app
# Set App URL = $APP_BASE_URL and redirect URL = $APP_BASE_URL/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_BACKFILL_DAYS=730
CELERY_BROKER_URL=redis://redis:6379/1
# true = run sync inline without a worker (tests / quick local dev)
CELERY_TASK_ALWAYS_EAGER=false

# ---- Forecasting ----
# Where HuggingFace caches amazon/chronos-bolt-small (~200 MB) on first run
HF_HOME=/app/.hf-cache

# ---- Amazon SP-API (Step 8) ----
# Login with Amazon credentials of your SP-API app + the app id for the Seller Central consent
# URL. Redirect URL registered in the app: $APP_BASE_URL/amazon/callback
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_APP_ID=
# ---- eBay (Step 8) ----
# Developer app keyset (production). RuName = the redirect URL name whose accept URL is
# $APP_BASE_URL/ebay/callback. Scopes: sell.fulfillment.readonly, sell.inventory.readonly
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# WooCommerce needs nothing here: each store's consumer key/secret is entered per channel.

# ---- Observability & ops (Step 9) ----
# Sentry projects: one for the API (SENTRY_DSN) and one for the web app (NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
# Logs: json (production, Railway/Grafana parse it) or text (local)
LOG_FORMAT=text
LOG_LEVEL=INFO
# OpenTelemetry traces -> Grafana Cloud (Tempo). From Grafana Cloud -> OpenTelemetry -> Configure:
# endpoint https://otlp-gateway-<region>.grafana.net/otlp and header
# "Authorization=Basic <base64(instanceId:token)>"
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=stockcast-api
# Alerts (ops.check_health every 15 min): Slack incoming webhook or Grafana OnCall webhook
ALERT_WEBHOOK_URL=
# Product analytics (PostHog project API key, phc_...). Empty = milestones recorded in the db only.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Weekly activation cohort report (Mondays 08:00 UTC) — comma-separated; needs RESEND_API_KEY
REPORT_EMAILS=
ALERT_SYNC_FAILURE_RATE=0.05
ALERT_FORECAST_MAX_MINUTES=30
# Transport security: true in staging/production (http -> https 308 + HSTS); hosts allowlist
FORCE_HTTPS=false
ALLOWED_HOSTS=
# RELEASE is set by the deploy workflow to the git sha (shows in /health/ready and Sentry)
RELEASE=
# Amazon SP-API notifications via EventBridge API destination (see routers/amazon_webhooks.py)
AMAZON_WEBHOOK_SECRET=
# Backups (Railway cron service `backup`, 03:00 UTC): S3-compatible bucket, 30-day retention
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=30
BACKUP_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Worker sizing: one forecast process per vCPU (default: nproc); api uvicorn workers
CELERY_CONCURRENCY=
WEB_CONCURRENCY=2

# ---- Auth (Step 7) ----
# header = X-Org-Id header, no login (dev / e2e / CSV-only). clerk = verified Clerk JWTs. NEVER
# run `header` in production.
AUTH_MODE=header
# From the Clerk dashboard -> API keys. JWKS: https://<frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_ISSUER=
# Optional: lets the API fetch org/user names on first sight (sk_...)
CLERK_SECRET_KEY=

# ---- Rate limiting (slowapi) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis://redis:6379/2
RATE_LIMIT_DEFAULT=600/minute
# imports, exports, forecast/planning runs, simulations
RATE_LIMIT_HEAVY=30/minute

# ---- Billing (Stripe) — optional ----
# Leave STRIPE_SECRET_KEY empty to run without billing: trials never lock, checkout is hidden.
# Once it is set, STRIPE_WEBHOOK_SECRET is required in staging/production.
# Plans: starter $39 (1 channel, 500 SKUs) | growth $99 (3, 5000) | scale $249 (unlimited).
# Create three recurring monthly prices in Stripe and paste their ids. Webhook endpoint:
# $APP_BASE_URL/webhooks/stripe with events checkout.session.completed,
# customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
TRIAL_DAYS=14

# ---- Email (Resend) ----
# Used for POs to suppliers and transactional mail (welcome, trial ending, sync failed, weekly
# stockout digest). Leave empty: mails are logged in email_log with status=skipped.
RESEND_API_KEY=
EMAIL_FROM=Stockcast <orders@stockcast.app>

# ---- Web ----
# Server-side fetch (inside docker network)
API_URL=http://api:8000
# Browser-side fetch
NEXT_PUBLIC_API_URL=http://localhost:8000
# Org used when no stockcast_org cookie is set (demo org from `make seed`) — header mode only
NEXT_PUBLIC_DEFAULT_ORG_ID=00000000-0000-0000-0000-00000000d3a0
# Clerk (https://clerk.com): setting the publishable key switches the web app to sign-in +
# organizations; the API must then run with AUTH_MODE=clerk. Enable Organizations in Clerk and
# add `org_id`, `org_role`, `email`, `name` to the session token claims (Sessions -> Customize).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Public site (marketing, privacy, terms, support pages — apps/web/lib/site.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@stockcast.app
NEXT_PUBLIC_LEGAL_ENTITY=Stockcast
# Embed URL (YouTube /embed/..., Loom /embed/..., Vimeo player URL); demo section hidden if empty
NEXT_PUBLIC_DEMO_VIDEO_URL=
# Pageviews (same PostHog project; key is public by design)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Postgres ----
POSTGRES_USER=stockcast
POSTGRES_PASSWORD=stockcast
POSTGRES_DB=stockcast
