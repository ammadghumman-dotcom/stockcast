# ---- API ----
ENV=development
DATABASE_URL=postgresql+psycopg://stockcast:stockcast@postgres:5432/stockcast
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
# Any string; used to derive the Fernet key that encrypts channel credentials. Rotate = re-connect channels.
CREDENTIALS_KEY=change-me-in-production
# Used by pytest (apps/api/tests/conftest.py); tests migrate + roll back on this DB
TEST_DATABASE_URL=postgresql+psycopg://stockcast:stockcast@localhost:5432/stockcast_test

# ---- Ingestion ----
# Public URL Shopify can reach for OAuth callback + webhooks (use an ngrok/cloudflared URL locally)
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Shopify Partner app credentials: https://partners.shopify.com -> Apps -> Create app
# Set App URL = $APP_BASE_URL and redirect URL = $APP_BASE_URL/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_BACKFILL_DAYS=730
CELERY_BROKER_URL=redis://redis:6379/1
# true = run sync inline without a worker (tests / quick local dev)
CELERY_TASK_ALWAYS_EAGER=false

# ---- Forecasting ----
# Where HuggingFace caches amazon/chronos-bolt-small (~200 MB) on first run
HF_HOME=/app/.hf-cache

# ---- Auth (Step 7) ----
# header = X-Org-Id header, no login (dev / e2e / CSV-only). clerk = verified Clerk JWTs. NEVER
# run `header` in production.
AUTH_MODE=header
# From the Clerk dashboard -> API keys. JWKS: https://<frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_ISSUER=
# Optional: lets the API fetch org/user names on first sight (sk_...)
CLERK_SECRET_KEY=

# ---- Rate limiting (slowapi) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis://redis:6379/2
RATE_LIMIT_DEFAULT=600/minute
# imports, exports, forecast/planning runs, simulations
RATE_LIMIT_HEAVY=30/minute

# ---- Billing (Stripe) ----
# Plans: starter $39 (1 channel, 500 SKUs) | growth $99 (3, 5000) | scale $249 (unlimited).
# Create three recurring monthly prices in Stripe and paste their ids. Webhook endpoint:
# $APP_BASE_URL/webhooks/stripe with events checkout.session.completed,
# customer.subscription.created|updated|deleted, invoice.paid, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
TRIAL_DAYS=14

# ---- Email (Resend) ----
# Used for POs to suppliers and transactional mail (welcome, trial ending, sync failed, weekly
# stockout digest). Leave empty: mails are logged in email_log with status=skipped.
RESEND_API_KEY=
EMAIL_FROM=Stockcast <orders@stockcast.app>

# ---- Web ----
# Server-side fetch (inside docker network)
API_URL=http://api:8000
# Browser-side fetch
NEXT_PUBLIC_API_URL=http://localhost:8000
# Org used when no stockcast_org cookie is set (demo org from `make seed`) — header mode only
NEXT_PUBLIC_DEFAULT_ORG_ID=00000000-0000-0000-0000-00000000d3a0
# Clerk (https://clerk.com): setting the publishable key switches the web app to sign-in +
# organizations; the API must then run with AUTH_MODE=clerk. Enable Organizations in Clerk and
# add `org_id`, `org_role`, `email`, `name` to the session token claims (Sessions -> Customize).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Postgres ----
POSTGRES_USER=stockcast
POSTGRES_PASSWORD=stockcast
POSTGRES_DB=stockcast
